{
    "name": "steevanb/php-url-test",
    "license": "MIT",
    "type": "lib",
    "description": "Tests all urls of your application",
    "autoload": {
        "psr-4": {
            "steevanb\\PhpUrlTest\\": "src/"
        }
    },
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "symfony/console": "^6.4 || ^7.4",
        "symfony/options-resolver": "^6.4 || ^7.4",
        "guzzlehttp/guzzle": "^7.5",
        "symfony/yaml": "^6.4 || ^7.4",
        "symfony/process": "^6.4 || ^7.4",
        "symfony/filesystem": "^6.4 || ^7.4"
    },
    "bin": ["bin/urltest"],
    "require-dev": {
        "symfony/var-dumper": "^6.4 || ^7.4"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://composer-satis.santeacademie.com"
        }
    ]
}
